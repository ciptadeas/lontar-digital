            border-radius: 40px;
            backdrop-filter: blur(12px);
            position: relative;
            z-index: 10;
        }

        .gold-pill-btn {
            background: linear-gradient(135deg, #edd27b 0%, #c89623 50%, #8c6008 100%);
            color: #1a0a03;
            font-weight: 900;
            border-radius: 9999px;
            border: 2px solid #fff2a8;
            box-shadow: 0 8px 25px rgba(200, 150, 35, 0.4), inset 0 2px 4px rgba(255, 255, 255, 0.6);
            transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        .gold-pill-btn:hover {
            transform: translateY(-4px) scale(1.04);
            box-shadow: 0 14px 35px rgba(237, 210, 123, 0.6);
            background: linear-gradient(135deg, #fff0aa 0%, #dca32a 50%, #9e6d0c 100%);
        }

        .gold-capsule-outline {
            background: rgba(30, 15, 8, 0.85);
            border: 2px solid #b8860b;
            border-radius: 9999px;
            color: #f7e3af;
            transition: all 0.25s ease;
        }
        .gold-capsule-outline:hover {
            border-color: #ffd700;
            background: rgba(55, 28, 12, 0.9);
            color: #fff;
        }

        .float-alive { animation: floatSmooth 4.5s infinite ease-in-out; }
        @keyframes floatSmooth {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-10px) rotate(2deg); }
        }

        @keyframes balloonFall {
            0% { transform: translateY(-10px); opacity: 1; }
            100% { transform: translateY(220px); opacity: 1; }
        }
        .falling-balloon {
            animation: balloonFall 6.5s linear forwards;
            border-radius: 50% 50% 50% 50% / 40% 40% 60% 60%;
        }

        .frog-anim { transition: all 0.6s cubic-bezier(0.34, 1.56, 0.64, 1); }

        @keyframes fishSwim {
            0% { transform: translateX(-20px) scaleX(1); }
            50% { transform: translateX(250px) scaleX(1); }
            51% { transform: translateX(250px) scaleX(-1); }
            100% { transform: translateX(-20px) scaleX(-1); }
        }
        .swimming-fish { animation: fishSwim 7s infinite ease-in-out; }
