    <script>
        const canvas = document.getElementById('glitter-canvas');
        const ctx = canvas.getContext('2d');
        let particles = [];
        function resizeCanvas() { canvas.width = window.innerWidth; canvas.height = window.innerHeight; }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();
        for (let i = 0; i < 40; i++) {
            particles.push({ x: Math.random() * canvas.width, y: Math.random() * canvas.height, radius: Math.random() * 2 + 1, alpha: Math.random(), speed: Math.random() * 0.3 + 0.1 });
        }
        function drawGlitter() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            particles.forEach(p => {
                ctx.beginPath(); ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
                ctx.fillStyle = `rgba(212, 175, 55, ${p.alpha})`; ctx.fill();
                p.y -= p.speed; if (p.y < 0) p.y = canvas.height;
            });
            requestAnimationFrame(drawGlitter);
        }
        drawGlitter();

        let currentSlide = 1;
        const totalSlides = 15;
        let totalScore = 0;

        function updateSlide() {
            document.querySelectorAll('.slide-step').forEach(s => s.classList.add('hidden'));
            document.getElementById(`slide-${currentSlide}`).classList.remove('hidden');
            document.getElementById('slide-num').innerText = currentSlide;
            window.scrollTo(0,0);
        }
        function nextSlide() { if (currentSlide < totalSlides) { currentSlide++; updateSlide(); } }
        function prevSlide() { if (currentSlide > 1) { currentSlide--; updateSlide(); } }

        function saveUserAndNext() {
            const name = document.getElementById('user-name').value.trim();
            const cls = document.getElementById('user-class').value.trim();
            if(!name) {
                alert("Mohon masukkan nama lengkap kamu terlebih dahulu ya!");
                return;
            }
            document.getElementById('display-user-name').innerText = name;
            document.getElementById('cert-user-name').innerText = name;
            document.getElementById('cert-user-class').innerText = cls ? `Kelas/Absen: ${cls}` : 'SMA Negeri 1 Gianyar';
            nextSlide();
        }

        const s1 = [
            { q: "1. Istilah untuk menyebut sistem filsafat dalam tradisi Hindu adalah...", opt: ["Darsana", "Yajna", "Dharma", "Samsara"], ans: 0 },
            { q: "2. Enam sistem filsafat Hindu dikenal dengan istilah...", opt: ["Catur Marga", "Sad Darsana", "Tri Kaya", "Panca Sradha"], ans: 1 },
            { q: "3. Sistem Darsana yang berfokus pada logika & penalaran...", opt: ["Yoga", "Mimamsa", "Nyaya", "Vedanta"], ans: 2 }
        ];
        const s2 = [
            { q: "4. Tokoh tradisional yang dikaitkan dengan Samkhya...", opt: ["Rsi Jaimini", "Rsi Kapila", "Rsi Patanjali", "Rsi Gautama"], ans: 1 },
            { q: "5. Konsep penting dalam ajaran Samkhya adalah...", opt: ["Purusa & Prakrti", "Dharma & Yajna", "Sruti & Smerti", "Rta & Karma"], ans: 0 },
            { q: "6. Sistem filsafat yang erat dengan disiplin & pengendalian diri...", opt: ["Vaiseshika", "Nyaya", "Yoga", "Mimamsa"], ans: 2 }
        ];

        let g1Idx = 0;
        function startGame1() { g1Idx = 0; renderG1(); }
        function renderG1() {
            if (g1Idx >= s1.length) { nextSlide(); startGame2(); return; }
            const q = s1[g1Idx]; document.getElementById('g1-soal').innerText = q.q;
            document.getElementById('g1-status').innerText = "";
            const cv = document.getElementById('g1-canvas'); cv.innerHTML = '';
            q.opt.forEach((o, idx) => {
                const b = document.createElement('div');
                b.className = 'absolute falling-balloon px-3 py-2 bg-amber-600 border border-amber-300 text-amber-950 font-black text-xs cursor-pointer';
                b.style.left = `${5 + idx * 24}%`; b.style.top = '0px'; b.innerText = `🎈 ${o}`;
                b.onclick = () => { if(idx === q.ans) totalScore += 15; document.getElementById('g1-score').innerText = `Skor: ${totalScore}`; g1Idx++; renderG1(); };
                cv.appendChild(b);
            });
        }

        let g2Idx = 0;
        function startGame2() { g2Idx = 0; renderG2(); }
        function renderG2() {
            if (g2Idx >= s2.length) { 
                document.getElementById('final-score').innerText = `${totalScore} / 100`;
                nextSlide(); 
                return; 
            }
            document.getElementById('frog').style.left = `${10 + g2Idx * 30}%`;
            const q = s2[g2Idx]; document.getElementById('g2-soal').innerText = q.q;
            const box = document.getElementById('g2-opsi'); box.innerHTML = '';
            q.opt.forEach((o, idx) => {
                const btn = document.createElement('button');
                btn.className = 'w-full text-left p-3 rounded-2xl border border-amber-800 bg-amber-950 text-amber-100 font-bold text-xs hover:bg-amber-900';
                btn.innerText = `${String.fromCharCode(65+idx)}. ${o}`;
                btn.onclick = () => { if(idx === q.ans) totalScore += 15; document.getElementById('g2-score').innerText = `Skor: ${totalScore}`; g2Idx++; renderG2(); };
                box.appendChild(btn);
            });
        }
    </script>
</body>
</html>
