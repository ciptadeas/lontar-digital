        .gold-gradient-text {
            background: linear-gradient(135deg, #ffe599 0%, #d4af37 45%, #aa7c11 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-shadow: 0 4px 15px rgba(212, 175, 55, 0.25);
        }

        #glitter-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            pointer-events: none;
            z-index: 0;
        }

        .gembul-card {
            background: linear-gradient(160deg, rgba(38,21,13,0.95) 0%, rgba(22,12,7,0.98) 100%);
